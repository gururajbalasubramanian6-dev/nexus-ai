# ==============================================================================
# NEXUS-AI: SAP HANA CLOUD CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in the project root:
#      copy .env.example .env
# 2. Fill in your actual SAP HANA Cloud credentials.
# 3. Never commit '.env' to version control (protected by .gitignore).
# ==============================================================================

# SAP HANA Cloud SQL Endpoint Hostname
# Note: From SAP HANA Cloud Central, copy the SQL Endpoint.
# You can supply just the hostname (e.g., abcdef-1234.hanacloud.ondemand.com)
# or hostname:port.
HANA_ADDRESS=your-hana-cloud-host.hanacloud.ondemand.com

# SAP HANA Cloud SQL Port
# Verify the exact port from your SAP BTP Cockpit / HANA Cloud Central instance.
# Common ports: 443 (default routed SQL port), 30015, 30215, or 39015.
HANA_PORT=443

# SAP Database User (must have SELECT privilege on schema HACKFEST0316)
HANA_USER=DBADMIN

# SAP Database User Password
HANA_PASSWORD=your_secure_password_here

# SAP Database Schema
HANA_SCHEMA=HACKFEST0316

# Security & TLS Encryption Settings
# SAP HANA Cloud requires TLS encryption (true)
HANA_ENCRYPT=true

# SSL Certificate Validation
# Set to 'true' for production/valid CA, or 'false' if connecting through custom corporate proxies
HANA_SSL_VALIDATE_CERTIFICATE=true

